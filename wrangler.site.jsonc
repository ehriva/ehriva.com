{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ehriva-com",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "ehriva.com/*", "zone_name": "ehriva.com" }
  ]
}
